{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartlingo.local/schemas/result-v2.json",
  "title": "ChartLingoV2 Illustrator result",
  "type": "object",
  "required": ["schema", "schemaVersion", "sourceDocument", "artboards", "validation"],
  "properties": {
    "schema": {"const": "https://chartlingo.local/schemas/result-v2.json"},
    "schemaVersion": {"const": "2.0.0"},
    "sourceDocument": {"type": "object", "required": ["id", "revision", "name"]},
    "artboards": {"type": "array", "items": {"type": "object", "required": ["id", "textFrames"], "properties": {"id": {"type": "string"}, "textFrames": {"type": "array", "items": {"$ref": "#/$defs/textFrame"}}, "graphicElements": {"type": "array", "items": {"$ref": "#/$defs/graphicElement"}}}}},
    "validation": {"type": "object"}
  },
  "$defs": {
    "rect": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "textFrame": {"type": "object", "required": ["id", "sourceText", "english", "layout", "style"], "properties": {"id": {"type": "string"}, "category": {"type": "string", "enum": ["header", "footer", "notes", "label", "value", "source", "credit"]}, "rotation": {"type": "number"}, "groupId": {"type": ["string", "null"]}, "metricGroupId": {"type": ["string", "null"]}, "slot": {"type": ["string", "null"], "enum": ["label", "value", "change-row", null]}, "layoutRole": {"type": ["string", "null"], "enum": ["metric-label", "metric-value", "metric-change", null]}, "fieldType": {"type": ["string", "null"], "enum": ["year", "quarter", "month", "period", "credit", "source", null]}, "contentType": {"type": ["string", "null"], "enum": ["chart", "graphic-label", "graphic-value", "graphic-percentage", null]}, "styleRole": {"type": "string"}, "lineBreakMode": {"type": ["string", "null"], "enum": ["auto", "single-line", "manual", "match-source", null]}, "manualLines": {"type": "array", "items": {"type": "string"}}, "translationLayout": {"type": "object", "properties": {"mode": {"enum": ["auto", "single-line", "manual", "match-source"]}, "width": {"type": ["number", "null"], "exclusiveMinimum": 0}, "inheritSourceWidth": {"type": "boolean"}, "manualLines": {"type": "array", "items": {"type": "string"}}}}, "mergedFrom": {"type": "array", "items": {"type": "string"}}, "csvField": {"type": ["string", "null"]}, "styleReferenceId": {"type": ["string", "null"]}, "inheritStyle": {"type": "boolean"}, "pairId": {"type": ["string", "null"]}, "sourceText": {"type": "string"}, "english": {"type": "string"}, "layout": {"type": "object"}, "style": {"type": "object"}}},
    "graphicElement": {"type": "object", "required": ["id", "contentType", "bounds", "style"], "properties": {"id": {"type": "string"}, "contentType": {"enum": ["indicator", "vector"]}, "metricGroupId": {"type": "string"}, "slot": {"enum": ["change-row"]}, "layoutRole": {"enum": ["indicator", "graphic"]}, "direction": {"type": ["string", "null"], "enum": ["up", "down", null]}, "bounds": {"$ref": "#/$defs/rect"}, "style": {"type": "object"}}}
  }
}
